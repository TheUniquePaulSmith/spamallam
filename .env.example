# =============================================================================
# SpamAllam — environment configuration
# Copy to .env and edit. Every variable used by the stack is documented here.
# =============================================================================

# -----------------------------------------------------------------------------
# Identity / mail routing (REQUIRED)
# -----------------------------------------------------------------------------
# Public FQDN of this gateway. Must match:
#   1. your domain's MX record,
#   2. the reverse-DNS (PTR) of your WAN IP,
#   3. the TLS certificate issued by the acme service.
MAIL_HOSTNAME=mail.example.com

# Comma-separated list of domains this gateway accepts mail FOR.
# Mail addressed to any other domain is rejected at SMTP time (no open relay).
MAIL_DOMAINS=example.com,example.org

# Where accepted, scanned mail is delivered — your internal mail server
# (e.g. Synology MailPlus after you move it off port 25).
#
# If your mail server runs on the SAME docker host as this stack (e.g.
# MailPlus on this Synology), do NOT use that host's real LAN IP here if
# postfix is on the mailwan macvlan network (see MACVLAN_* below) — Linux's
# macvlan driver cannot route between a macvlan child and the physical host
# that owns the parent interface, so postfix would never be able to reach it
# and mail queues up undeliverable ("Host is unreachable"). Use the docker
# bridge gateway IP instead (the `mailnet` network's gateway, typically the
# first address of DOCKER_SUBNET, e.g. 172.28.0.1) — that path stays on the
# bridge network and reaches the host's own listener normally, as long as
# your mail server listens on all interfaces (the usual default). Verify with:
#   docker network inspect <project>_mailnet --format '{{(index .IPAM.Config 0).Gateway}}'
#   docker exec spamallam-postfix nc -zv -w5 <that-gateway-ip> <MAILSERVER_PORT>
#
# If your mail server is on a genuinely different host, its normal LAN IP is
# fine — this restriction only applies when it's the same physical box.
MAILSERVER_HOST=172.28.0.1
MAILSERVER_PORT=2526

# -----------------------------------------------------------------------------
# Inbound networking (macvlan)
#
# postfix gets its own real LAN IP/MAC on a dedicated network (the "mailwan"
# network in docker-compose.yml) instead of being reached through Docker's
# port-publish NAT. That matters: with plain port publishing, some Docker
# hosts (Synology Container Manager included) rewrite the connecting client's
# source IP to the docker bridge gateway address before postfix ever sees it —
# which falls inside `mynetworks` and silently turns permit_mynetworks into an
# open relay. macvlan avoids the rewrite entirely. See docs/SECURITY.md.
#
# MACVLAN_PARENT   the host NIC macvlan attaches to. Find it with
#                  `ip -o link show` on the docker host (Synology: SSH in).
# MACVLAN_SUBNET   the LAN/VLAN postfix's IP lives on, in CIDR.
# MACVLAN_GATEWAY  that subnet's router IP.
# POSTFIX_MACVLAN_IP
#                  the IP postfix itself uses. Pick a free address in
#                  MACVLAN_SUBNET yourself — Docker's macvlan driver assigns
#                  this statically from its own IPAM config below, it does
#                  NOT ask your router's DHCP server for a lease, so there is
#                  no "let it show up in DHCP, then reserve it" step. Once
#                  you've picked it, exclude it from your router's DHCP pool
#                  (or add a reservation for it) so nothing else can ever be
#                  handed the same address.
#
# Point your gateway's WAN :25 (and :587, if ENABLE_STARTTLS_PORT) port
# forward at POSTFIX_MACVLAN_IP:2525 / :2587 — not at the docker host.
# -----------------------------------------------------------------------------
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.4.0/28
MACVLAN_GATEWAY=192.168.4.1
POSTFIX_MACVLAN_IP=192.168.4.10

# The 2587 listener requires STARTTLS before MAIL FROM. Set false to disable it.
ENABLE_STARTTLS_PORT=true

# -----------------------------------------------------------------------------
# Recipient validation
#   domain : accept ANY local-part of MAIL_DOMAINS (default; supports plus
#            addressing like paul+lists@example.com; rely on your mail server's
#            catch-all / unknown-recipient handling)
#   list   : only accept addresses in RELAY_RECIPIENTS (comma-separated)
#   verify : probe MAILSERVER_HOST per recipient (cached); plus-suffix stripped
# -----------------------------------------------------------------------------
RECIPIENT_VALIDATION=domain
RELAY_RECIPIENTS=

# -----------------------------------------------------------------------------
# Docker network subnet for the stack (postfix trusts exactly this subnet as
# mynetworks for re-injection; change only if it collides with your LAN)
# -----------------------------------------------------------------------------
DOCKER_SUBNET=172.28.0.0/24

# -----------------------------------------------------------------------------
# Postfix hardening knobs
# -----------------------------------------------------------------------------
# Max message size in bytes (default 25 MiB)
MESSAGE_SIZE_LIMIT=26214400
# Junk (NOOP/VRFY/ETRN/unknown) commands allowed per session before disconnect
JUNK_COMMAND_LIMIT=50
# Per-client parallel connections / connections-per-minute
SMTPD_CLIENT_CONNECTION_COUNT_LIMIT=10
SMTPD_CLIENT_CONNECTION_RATE_LIMIT=30
# postscreen DNS blocklists (weighted) and score threshold
POSTSCREEN_DNSBL_SITES=zen.spamhaus.org*3 bl.spamcop.net*2
POSTSCREEN_DNSBL_THRESHOLD=3

# -----------------------------------------------------------------------------
# Shared secrets (REQUIRED — generate strong random values)
#   e.g.:  openssl rand -hex 32
# -----------------------------------------------------------------------------
# Signs the X-SpamAllam-* headers so rspamd can trust them (anti-spoofing).
HEADER_HMAC_KEY=change-me-openssl-rand-hex-32
# Master key for encrypting secrets at rest in the spamallam /data volume
# (LLM API keys, PFX password, etc). Losing it means re-entering secrets.
SECRETS_KEY=change-me-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# spamallam admin UI
# -----------------------------------------------------------------------------
# Host bind for the HTTPS admin UI. Loopback-only by default.
# LAN example: ADMIN_BIND=192.168.1.10:8443   — NEVER expose to the internet.
# Low ports (e.g. :443) work fine here — Docker's host-side port publishing
# does not require any capability inside the container — but check nothing
# else on the host (e.g. your NAS's own admin UI) already uses that port.
ADMIN_BIND=127.0.0.1:8443
# The port from ADMIN_BIND above (just the port, e.g. 25443 or 443). Used only
# to build correct setup/invite links shown to users — leave empty to default
# to 8443 (the container's internal port), which is wrong if you publish under
# a different host port. Set this whenever ADMIN_BIND's port isn't 8443.
ADMIN_EXTERNAL_PORT=
# Hostname you will use in the browser for the admin UI. Required for passkeys:
# WebAuthn refuses bare IP addresses, so give this a real internal DNS name
# (e.g. spamallam.hq.example.com -> your NAS internal IP) and include it in
# ACME_DOMAINS so the admin UI gets a matching certificate. Defaults to
# MAIL_HOSTNAME if unset (single-hostname deployments).
ADMIN_EXTERNAL_HOST=
# Optional: pre-set the one-time first-admin enrollment token. If empty, a
# random token is generated on first boot and printed to the container logs.
SETUP_TOKEN=
# Which certificate directory under the shared certs volume to use (defaults
# to MAIL_HOSTNAME). Certs live at /certs/<name>/fullchain.pem + key.pem.
TLS_CERT_NAME=

# Bound on simultaneous AI analyses (protects your local AI node under load)
MAX_CONCURRENT_ANALYSES=4
# Per-message cap on total AI analysis time (seconds) before failure mode applies.
# This is only the default: Admin UI -> AI -> Analysis timeout overrides it without
# a restart, and is what you'll actually want to tune for a slower self-hosted model.
AI_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# rspamd
# -----------------------------------------------------------------------------
# Password for the rspamd controller web UI (http://<docker-host>:11334)
RSPAMD_PASSWORD=change-me
# Host bind for the rspamd web UI. Loopback-only by default.
RSPAMD_UI_BIND=127.0.0.1:11334
# VirusTotal API key (free tier works; leave empty to disable the VT rule)
VT_API_KEY=
# Score weights the custom Lua plugin assigns to spamallam verdicts
# (scaled by the AI's reported confidence; HAM weight must be negative)
SPAMALLAM_SPAM_WEIGHT=6.0
SPAMALLAM_PHISH_WEIGHT=8.0
SPAMALLAM_MALICIOUS_WEIGHT=12.0
SPAMALLAM_HAM_WEIGHT=-3.0

# -----------------------------------------------------------------------------
# redis
# -----------------------------------------------------------------------------
REDIS_MAXMEMORY=256mb

# -----------------------------------------------------------------------------
# acme.sh (LetsEncrypt certificates, DNS-01 challenge)
# The acme container is the only writer to the shared certs volume.
# Leave ACME_DNS_PROVIDER empty to disable (self-signed certs are generated
# automatically so the stack still runs — replace them before going live).
# -----------------------------------------------------------------------------
# acme.sh dns hook name, e.g. dns_cf (Cloudflare), dns_synology_dsm, dns_aws...
ACME_DNS_PROVIDER=
ACME_EMAIL=you@example.com
# Comma-separated hostnames to issue (default: MAIL_HOSTNAME)
ACME_DOMAINS=
# letsencrypt | letsencrypt_test | zerossl | buypass
ACME_SERVER=letsencrypt
# Provider credentials — add the ones YOUR dns provider needs (examples):
CF_Token=
CF_Account_ID=
SYNO_Username=
SYNO_Password=

# -----------------------------------------------------------------------------
# UniFi network blocking tool (all also editable in the admin UI)
# -----------------------------------------------------------------------------
# e.g. https://192.168.1.1  (UniFi OS console)
UNIFI_URL=
# UniFi Network API key (Settings -> Control Plane -> Integrations)
UNIFI_API_KEY=
# Name of the UniFi "Network List" / firewall group updated with blocked CIDRs
UNIFI_NETWORK_LIST=spamallam-blocked

# -----------------------------------------------------------------------------
# GeoIP (ip_lookup tool). Mount or download a MaxMind GeoLite2 database into
# the spamallam /data volume and point at it here.
# -----------------------------------------------------------------------------
GEOIP_DB_PATH=/data/geoip/GeoLite2-City.mmdb
